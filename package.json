{
  "name": "paidextension-site",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing and docs site for PaidExtension, served from docs/ via GitHub Pages at https://paidextension.dev",
  "scripts": {
    "lint": "eslint docs",
    "lint:html": "html-validate \"docs/**/*.html\"",
    "check:links": "node scripts/check-links.js",
    "check:csp": "node scripts/check-csp.js",
    "check:jsonld": "node scripts/check-jsonld.js",
    "check:stamps": "node scripts/stamp-assets.js --check",
    "og": "node scripts/render-og.js",
    "stamp": "node scripts/stamp-assets.js",
    "check": "npm run lint && npm run lint:html && npm run check:links && npm run check:csp && npm run check:jsonld && npm run check:stamps",
    "serve": "python3 -m http.server 8898 --directory docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.8.1",
    "html-validate": "^11.8.0",
    "puppeteer-core": "25.10.0"
  },
  "engines": {
    "node": ">=22"
  }
}
